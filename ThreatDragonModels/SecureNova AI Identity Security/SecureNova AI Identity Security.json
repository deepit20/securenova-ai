          {
            "position": { "x": 475, "y": 450 },
            "size": { "width": 60, "height": 60 },
            "attrs": {
              "text": {
                "text": "AI Agent\n(LLM Powered)"
              },
              "body": {
                "stroke": "#c0392b",
                "strokeWidth": 2
              }
            },
            "visible": true,
            "shape": "process",
            "id": "proc-ai-agent",
            "zIndex": 3,
            "data": {
              "type": "tm.Process",
              "name": "AI Agent (LLM Powered)",
              "description": "Non-human identity: OBO user JWT + constrained M2M client.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "privilegeLevel": "Delegated user",
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "#1 Spoofed AI agent presents stolen OBO token",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker intercepts or replays a stolen On-Behalf-Of JWT to impersonate a legitimate user session via the AI agent.",
                  "mitigation": "Enforce short-lived token lifetimes, sender-constrained tokens (DPoP/mTLS), and strict audience validation.",
                  "number": 1
                },
                {
                  "id": "threat-2",
                  "title": "#2 RAG context or tool arguments tampered",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Adversarial prompt injection modifies context embeddings or function call arguments prior to tool invocation.",
                  "mitigation": "Implement rigid JSON schema validation, input sanitation, and contextual guardrails.",
                  "number": 2
                },
                {
                  "id": "threat-3",
                  "title": "#3 Missing non-human identity audit trail",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Actions taken autonomously by the AI agent cannot be definitively correlated to the originating human initiator.",
                  "mitigation": "Correlate human session IDs with non-human M2M audit logs in tamper-proof immutable logging stores.",
                  "number": 3
                },
                {
                  "id": "threat-4",
                  "title": "#4 Prompt injection discloses LLM API key",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "System prompt leakage or direct extraction attacks reveal backend API keys and model provider access tokens.",
                  "mitigation": "Isolate API keys in secure backend orchestration layers; never pass raw credentials in model context.",
                  "number": 4
                },
                {
                  "id": "threat-5",
                  "title": "#5 Unbounded tool loops exhaust quotas",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Malformed responses cause infinite recursive tool invocation loops, consuming downstream rate limits and API budgets.",
                  "mitigation": "Set strict recursion step limits, global execution timeouts, and circuit breakers on all tool calls.",
                  "number": 5
                },
                {
                  "id": "threat-6",
                  "title": "#6 Agent elevates to admin API scope",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "A low-privileged user coerces the AI agent to invoke administrative internal APIs by abusing overly broad backend scopes.",
                  "mitigation": "Apply principle of least privilege, strict RBAC/ABAC enforcement, and scope downscoped tokens at tool runtime.",
                  "number": 6
                }
              ]
            }
