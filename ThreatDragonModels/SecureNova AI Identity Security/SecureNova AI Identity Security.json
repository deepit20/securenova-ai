            "zIndex": 3,
            "data": {
              "type": "tm.Process",
              "name": "AI Agent\n(LLM Powered)",
              "description": "Non-human identity: OBO user\nJWT + constrained M2M client.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "privilegeLevel": "Delegated user",
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "#1 Spoofed AI agent presents stolen OBO token",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Spoofed AI agent presents stolen OBO token",
                  "mitigation": "Enforce short-lived OBO tokens with sender-constrained proof of possession.",
                  "number": 1
                },
                {
                  "id": "threat-2",
                  "title": "#2 RAG context or tool arguments tampered",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "RAG context or tool arguments tampered",
                  "mitigation": "Sign and validate contextual embeddings and function call payloads.",
                  "number": 2
                },
                {
                  "id": "threat-3",
                  "title": "#3 Missing non-human identity audit trail",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Missing non-human identity audit trail",
                  "mitigation": "Correlate human user sessions with M2M agent service audit records.",
                  "number": 3
                },
                {
                  "id": "threat-4",
                  "title": "#4 Prompt injection discloses LLM API key",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Prompt injection discloses LLM API key",
                  "mitigation": "Isolate API keys in backend secret managers; never expose credentials to the context window.",
                  "number": 4
                },
                {
                  "id": "threat-5",
                  "title": "#5 Unbounded tool loops exhaust quotas",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Unbounded tool loops exhaust quotas",
                  "mitigation": "Enforce recursion depth limits, call timeouts, and tool invocation budgets.",
                  "number": 5
                },
                {
                  "id": "threat-6",
                  "title": "#6 Agent elevates to admin API scope",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Agent elevates to admin API scope",
                  "mitigation": "Implement fine-grained scoped tokens with least privilege principle.",
                  "number": 6
                }
              ]
            }
